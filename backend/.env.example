# Groq API (gratis en https://console.groq.com)
GROQ_API_KEY=gsk_tu_api_key_aqui
GROQ_MODEL=llama3-70b-8192

# Tiempo máximo de espera por llamada a Groq (segundos)
GROQ_TIMEOUT=60

# Pipeline de agentes
AGENT_TIMEOUT=120        # Timeout por cada agente (segundos)
MAX_WORKERS=4            # Hilos del ThreadPoolExecutor

# WebSocket
WS_MAX_CONNECTIONS=10    # Conexiones WebSocket simultáneas
WS_INACTIVITY_TIMEOUT=300  # Tiempo de inactividad antes de desconectar (segundos)
WS_CLEANUP_INTERVAL=30     # Intervalo de limpieza de conexiones muertas (segundos)
WS_RECEIVE_TIMEOUT=120     # Timeout por mensaje WebSocket recibido (segundos)

# CORS
CORS_ALLOWED_ORIGINS='["http://localhost:8080","http://localhost:4200"]'
